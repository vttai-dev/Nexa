{
  "AllowedHosts": "localhost;127.0.0.1",
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
  },
  "Cors": { "AllowedOrigins": [] },
  "RateLimits": { "AuthPermitLimit": 10, "WritePermitLimit": 30 },
  "AccountMessages": {
    "EnableEmailDelivery": false,
    "EnablePhoneDelivery": false,
    "RequireVerifiedContacts": false,
    "UseDevelopmentOutbox": false
  }
}
